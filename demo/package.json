{
  "name": "a2ui-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo": "node scripts/start.mjs",
    "demo:live": "node scripts/start.mjs --live",
    "start:client": "npm start -w client",
    "build:client": "npm run build -w client",
    "test": "npm test -w agent && npm test -w client -- --watch=false"
  },
  "overrides": {
    "@a2ui/angular": {
      "@angular/core": "^22.2.3",
      "@angular/common": "^22.2.3",
      "@angular/platform-browser": "^22.2.3"
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "license": "MIT"
}
