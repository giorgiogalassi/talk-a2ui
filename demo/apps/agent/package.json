{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A2UI demo agent (support tickets), adapted from the official A2UI Node restaurant_finder sample (Apache-2.0)",
  "scripts": {
    "build": "npm run build -w @demo/catalog && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\"",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "start:stub": "STUB_LLM=true node dist/src/index.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@a2ui/agent": "0.0.2",
    "@a2ui/web_core": "^0.14.0",
    "@demo/catalog": "*",
    "@google/genai": "^2.8.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
