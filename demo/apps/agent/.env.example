# Copy to .env and paste a Gemini API key (https://aistudio.google.com/apikey).
# Leave it empty to run the stub only: npm run start:stub -w agent (from demo/).
GEMINI_API_KEY=
# Optional: MINIMAL (default) | LOW | MEDIUM | HIGH | DEFAULT (the model's own setting)
# GEMINI_THINKING_LEVEL=MINIMAL
# Optional: a model call that takes longer than this (ms) fails the attempt (default 30000)
# GEMINI_CALL_TIMEOUT_MS=30000
